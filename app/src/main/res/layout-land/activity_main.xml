<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/layout_padding"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/android:colorBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- หัวข้อแอปพลิเคชัน -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/app_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- ส่วนจัดวาง 2 คอลัมน์ซ้าย-ขวาสำหรับแนวนอน -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- ฝั่งซ้าย: ส่วนรับข้อมูล (น้ำหนัก, ส่วนสูง) และปุ่มคำนวณ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingEnd="@dimen/row_spacing"
                tools:ignore="RtlSymmetry">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <!-- แถวน้ำหนัก -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="@dimen/row_spacing">

                        <TextView
                            android:id="@+id/tvWeightLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/etWeight"
                            android:paddingStart="0dp"
                            android:paddingEnd="@dimen/row_spacing"
                            android:text="@string/label_weight"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />

                        <EditText
                            android:id="@+id/etWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/input_field_height"
                            android:background="@android:drawable/editbox_background_normal"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />
                    </TableRow>

                    <!-- แถวส่วนสูง -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="@dimen/row_spacing">

                        <TextView
                            android:id="@+id/tvHeightLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/etHeight"
                            android:paddingStart="0dp"
                            android:paddingEnd="@dimen/row_spacing"
                            android:text="@string/label_height"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />

                        <EditText
                            android:id="@+id/etHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/input_field_height"
                            android:background="@android:drawable/editbox_background_normal"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />
                    </TableRow>
                </TableLayout>

                <!-- ปุ่มคำนวณ -->
            </LinearLayout>

            <!-- ฝั่งขวา: ส่วนแสดงผลลัพธ์ (BMI, เกณฑ์) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/row_spacing"
                tools:ignore="RtlSymmetry">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1">

                    <!-- แถวค่าดัชนีมวลกาย -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="@dimen/row_spacing">

                        <TextView
                            android:id="@+id/tvBmiLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="@dimen/row_spacing"
                            android:text="@string/label_bmi"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tvBmiResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/input_field_height"
                            android:background="@color/bg_gray"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />
                    </TableRow>

                    <!-- แถวเกณฑ์ผลลัพธ์ -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingBottom="@dimen/row_spacing">

                        <TextView
                            android:id="@+id/tvCategoryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="0dp"
                            android:paddingEnd="@dimen/row_spacing"
                            android:text="@string/label_category"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/tvCategoryResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/input_field_height"
                            android:background="@color/bg_gray"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_spacing"
            android:background="@color/button_color"
            android:gravity="center"
            android:minWidth="@dimen/button_min_width"
            android:text="@string/btn_calculate"
            android:textColor="@color/white_text_button"
            android:textSize="@dimen/text_size_body" />

    </LinearLayout>
</ScrollView>